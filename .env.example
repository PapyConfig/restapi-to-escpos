# Clé exigée dans l'en-tête X-API-Key (générer : openssl rand -hex 32)
API_KEY=change-me
# Imprimante unique (nommée "default")
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100
# 576 = papier 80 mm, 384 = papier 58 mm (points à 203 dpi)
PRINTER_WIDTH=576
PRINTER_PROFILE=default
# Plusieurs imprimantes (remplace PRINTER_HOST) :
# PRINTERS=[{"name":"caisse","host":"192.168.1.100"},{"name":"cuisine","host":"192.168.1.101","width":384}]
# DEFAULT_PRINTER=caisse
PRINTER_TIMEOUT=10
# Origines navigateur autorisées (vide = aucune)
CORS_ORIGINS=
# Interface web sur /ui/ (true/false)
UI_ENABLED=false
LOG_LEVEL=INFO
